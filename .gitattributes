# 统一以 LF 存储，避免 Windows / macOS / Linux 之间出现无意义的整文件 diff
* text=auto eol=lf

*.go   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.cs   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.mp4  binary
*.exe  binary
