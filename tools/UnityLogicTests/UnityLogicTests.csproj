<Project Sdk="Microsoft.NET.Sdk">

  <!--
    这个工程的作用：在没有安装 Unity 编辑器的机器上，真实执行 Unity 侧「纯逻辑」单元测试。

    做法是把 unity/Assets/Scripts/Core 与 unity/Assets/Tests/EditMode/Core 下的 .cs 文件
    以链接方式（Compile Include）纳入本工程编译，而不是复制一份代码 —— 这样保证
    「Unity 里跑的测试」和「这里跑的测试」永远是同一份源文件，不会出现两套实现跑偏。

    这些文件刻意不引用 UnityEngine，因此可以在普通 .NET 运行时下编译执行。
    在装有 Unity 的机器上，同样的用例可以直接用 Unity Test Runner（Window > General > Test Runner > EditMode）运行。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>UnityAR.Tests.EditMode</RootNamespace>
    <AssemblyName>UnityAR.Tests.EditMode</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\unity\Assets\Scripts\Core\**\*.cs" />
    <Compile Include="..\..\unity\Assets\Tests\EditMode\Core\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
